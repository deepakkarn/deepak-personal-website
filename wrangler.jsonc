{
  "name": "deepak-personal-website",
  "compatibility_date": "2026-11-20",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "BLOG_DB",
      "database_name": "deepakkarn-blog",
      "database_id": "88cb1855-2b0b-4d56-8308-2d630c13b9cd"
    }
  ]
}
